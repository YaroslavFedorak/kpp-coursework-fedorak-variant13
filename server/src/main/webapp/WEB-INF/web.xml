<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <servlet>
        <servlet-name>RoomServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.RoomServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RoomServlet</servlet-name>
        <url-pattern>/rooms</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TechnicianServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.TechnicianServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TechnicianServlet</servlet-name>
        <url-pattern>/technicians</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ServiceRequestServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.ServiceRequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServiceRequestServlet</servlet-name>
        <url-pattern>/requests</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>WorkRecordServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.WorkRecordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>WorkRecordServlet</servlet-name>
        <url-pattern>/work-records</url-pattern>
    </servlet-mapping>
</web-app>
